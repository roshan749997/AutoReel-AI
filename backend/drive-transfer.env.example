# Drive Transfer only. Add these to backend/.env.
# Do not replace GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, or GOOGLE_REDIRECT_URI.
# Create a separate OAuth client. See docs/DRIVE_TRANSFER.md.

DRIVE_TRANSFER_GOOGLE_CLIENT_ID=
DRIVE_TRANSFER_GOOGLE_CLIENT_SECRET=
DRIVE_TRANSFER_REDIRECT_URI=http://localhost:5000/api/drive-transfer/oauth/callback
DRIVE_TRANSFER_OAUTH_SCOPE=https://www.googleapis.com/auth/drive
DRIVE_TRANSFER_MAX_FILES=50000
