# Backend Environment Variables Template
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 32-byte hexadecimal encryption key for OAuth tokens
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MongoDB Atlas URI (or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/video_automation

# AI Provider: gemini | ollama | manual
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Google OAuth (Drive & YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/accounts/google/callback
GOOGLE_DRIVE_FOLDER_ID=

# Meta / Instagram Graph API (Instagram Login)
# Note: For Instagram Login, copy the Instagram App ID from:
# Meta Dashboard -> Use cases -> Customize -> API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/accounts/meta/callback
META_AUTH_FLOW=instagram_login

# n8n Automation
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/video-pipeline
