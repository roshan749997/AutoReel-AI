# ==============================================================================
# AI Video Automation Agent - Safe Environment Variable Template (.env.example)
# DO NOT PUT REAL SECRETS IN THIS FILE. COPY TO .env IN RESPECTIVE FOLDERS.
# ==============================================================================

# ==========================================
# 1. BACKEND & SECURITY SETTINGS
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Strong AES-256 Secret (At least 32 characters) used to encrypt OAuth tokens in DB
# Generate on Windows with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_never_share_this

# MongoDB Atlas Connection String (free M0 cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/video_automation?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/video_automation

# ==========================================
# 2. FREE AI PROVIDER CONFIGURATION
# Provider options: "gemini" (Free tier), "ollama" (Local 0-cost), "manual"
# ==========================================
AI_PROVIDER=gemini

# Google AI Studio Gemini API Key (100% Free tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama settings (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ==========================================
# 3. GOOGLE DRIVE & YOUTUBE OAUTH (Official Google Cloud Console)
# Setup free Google Cloud Project, enable Google Drive API v3 & YouTube Data API v3
# ==========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/accounts/google/callback

# Target Google Drive Folder ID containing your 20,000+ video library
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ==========================================
# 4. INSTAGRAM GRAPH API (Official Meta for Developers)
# Meta App -> Instagram Graph API -> Content Publishing API
# ==========================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:5000/api/accounts/meta/callback

# ==========================================
# 5. SELF-HOSTED N8N WORKFLOW AUTOMATION
# ==========================================
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/video-pipeline
N8N_API_KEY=your_n8n_api_key_if_used
